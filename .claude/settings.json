{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/session_hooks.py\" start 2>/dev/null || python3 \"$CLAUDE_PROJECT_DIR/scripts/session_hooks.py\" start",
            "timeout": 60,
            "statusMessage": "Loading the role's state and inbox"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/session_hooks.py\" prompt 2>/dev/null || python3 \"$CLAUDE_PROJECT_DIR/scripts/session_hooks.py\" prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/session_hooks.py\" guard 2>/dev/null || python3 \"$CLAUDE_PROJECT_DIR/scripts/session_hooks.py\" guard",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/session_hooks.py\" stop 2>/dev/null || python3 \"$CLAUDE_PROJECT_DIR/scripts/session_hooks.py\" stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
