   "source": [
    "from typing import Callable\n",
    "\n",
    "\n",
    "def outer(func: Callable) -> Callable:\n",
    "    def wrapper():\n",
    "        print(\"Before function call\")\n",
    "        result = func()\n",
    "        print(\"After function call\")\n",
    "        return result\n",
    "    return wrapper"
   ],
